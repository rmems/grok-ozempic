#!/usr/bin/env bash
# Fast pre-commit gate — see REVIEW.md
# Enable: git config core.hooksPath .githooks
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "${root}"

if ! command -v just >/dev/null 2>&1; then
  echo "pre-commit: 'just' is required; install it before committing." >&2
  exit 1
fi

echo "pre-commit: just check (see REVIEW.md)"
exec just check
