{
  "description": "Repository-local Codex commit attribution hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; hook=\"$repo_root/.codex/hooks/coauthor-record-head.sh\"; [ -f \"$hook\" ] || exit 0; bash \"$hook\"",
            "timeout": 3,
            "statusMessage": "Recording the pre-commit HEAD for Codex attribution"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0; hook=\"$repo_root/.codex/hooks/coauthor-commit.sh\"; [ -f \"$hook\" ] || exit 0; bash \"$hook\"",
            "timeout": 10,
            "statusMessage": "Checking Codex co-author trailer"
          }
        ]
      }
    ]
  }
}
